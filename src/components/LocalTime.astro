---
import Occitanie from '../assets/drapeaux/occitanie.svg';
import { site } from '../config/site';
import { fr } from '../i18n/fr';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={['label-micro flex items-center gap-2', className]}>
  <Occitanie class="h-2.5 w-auto rounded-flag" aria-hidden="true" />
  <span>{site.city}</span>
  <time data-local-time aria-label={fr.localTime}>--:--</time>
</p>

<script>
  import '../lib/live-clock';
</script>
