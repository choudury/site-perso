---
/*
 * Carte cliquable pour écrire : photo (toujours « en ligne »), adresse mail, délai de réponse et flèche.
 * Utilisée dans le bloc contact et en bas du menu mobile.
 */
import Icon from './ui/Icon.astro';
import ProfilePhoto from './ProfilePhoto.astro';
import { site } from '../config/site';
import { fr } from '../i18n/fr';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href={`mailto:${site.email}`}
  aria-label={`${fr.contact.emailLabel} ${site.email}`}
  class:list={[
    'group flex w-full max-w-prose items-center gap-3 rounded-card bg-night-surface p-2 pr-4 text-on-night transition-colors duration-(--duration-base) ease-out hover:bg-night-surface-hover sm:gap-5 sm:p-3 sm:pr-6',
    className,
  ]}
>
  <ProfilePhoto
    class="size-12 sm:size-16"
    alwaysOnline
    dotClass="bg-online-bright"
    badgeClass="bg-night-surface text-night-muted transition-colors duration-(--duration-base) ease-out group-hover:bg-night-surface-hover"
  />
  <span class="flex min-w-0 flex-1 flex-col">
    <span class="truncate text-body font-medium sm:text-lead">{site.email}</span>
    <span class="text-small text-night-muted">{fr.contact.responseTime}</span>
  </span>
  <Icon
    name="arrow-right"
    class="size-5 shrink-0 sm:size-6 transition-transform duration-(--duration-fast) ease-out group-hover:translate-x-1"
  />
</a>
