---
/*
 * Parcours professionnel en frise chronologique : un point par poste, reliés par un filet fin.
 * Le nom de l'entreprise est précédé d'un petit avatar carré gris aux angles arrondis, à son logo en noir.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Tag from '../ui/Tag.astro';
import { fr } from '../../i18n/fr';

const experiences = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);

// Les logos sont rangés dans src/assets/logos/ (le mien : src/assets/logo.svg) et désignés dans experiences.yaml.
// Un SVG est inséré tel quel pour prendre la couleur du texte (currentColor) ; une image doit être fournie en noir.
const svgLogos = import.meta.glob<string>(['/src/assets/logo.svg', '/src/assets/logos/*.svg'], {
  query: '?raw',
  import: 'default',
  eager: true,
});
const imageLogos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*.{png,webp}', { eager: true });
const logoFor = (path?: string) => {
  const key = `/src/assets/${path}`;
  return path ? { svg: svgLogos[key], image: imageLogos[key]?.default } : {};
};

// Réglages optiques des logos SVG : centrés et à la même taille, ils ne paraissent pas équilibrés.
// Le mien, plein, penche à droite (poussé d'un demi-pixel à gauche). Ceux de SawUp et des Spartiates,
// plus épurés, paraissent plus petits à taille égale : ils sont agrandis (12 et 13 px au lieu de 10).
const opticalFit: Record<string, string> = {
  'logo.svg': '[&_svg]:size-2.5 [&_svg]:-translate-x-[0.5px]',
  'logos/les-spartiates.svg': '[&_svg]:size-3.25',
  'logos/sawup.svg': '[&_svg]:size-3',
};
---

<section aria-labelledby="parcours-titre" class="mx-auto w-full max-w-site px-gutter pt-section">
  <h2 id="parcours-titre" class="text-h2 font-medium">{fr.about.experience.title}</h2>

  <!-- Les colonnes sont partagées par toutes les lignes (subgrid) : la colonne des dates prend
       la largeur de la plus longue et commence au bord gauche, sous le titre. -->
  <ol class="mt-10 grid grid-cols-[1.5rem_1fr] gap-x-4 md:mt-14 md:grid-cols-[max-content_1.5rem_1fr] md:gap-x-8">
    {
      experiences.map(({ data }, index) => {
        const logo = logoFor(data.logo);
        return (
          <li class="col-span-full grid grid-cols-subgrid">
            {/* Dates : à gauche sur desktop, au-dessus du poste sur mobile. */}
            <p class="col-start-2 text-small font-medium text-muted tabular-nums md:col-start-1 md:row-start-1 md:pt-1 md:text-right">
              {data.start} — {data.end ?? fr.about.experience.today}
            </p>

            {/* Point et filet de la frise. */}
            <div class="relative col-start-1 row-span-2 row-start-1 flex justify-center md:col-start-2">
              <span
                class:list={['relative z-1 mt-1.5 size-3 rounded-full', data.current ? 'bg-accent' : 'bg-neutral-300']}
              />
              {index < experiences.length - 1 && <span class="absolute top-6 bottom-0 w-px bg-line" />}
            </div>

            <div class="col-start-2 flex flex-col gap-2 pt-2 pb-12 md:col-start-3 md:row-start-1 md:pt-0 md:pb-16">
              <h3 class="flex flex-wrap items-center gap-x-3 gap-y-2 text-h3 font-medium">
                {data.role}
                {data.current && <Tag tone="accent">{fr.about.experience.current}</Tag>}
              </h3>
              <p class="flex items-center gap-2 text-body font-medium">
                {/* Avatar : logo de l'entreprise en noir sur gris clair (vide en attendant le logo). */}
                <span
                  class:list={[
                    'grid size-6 shrink-0 place-items-center rounded-avatar bg-surface-hover text-ink',
                    (data.logo && opticalFit[data.logo]) ?? '[&_svg]:size-2.5',
                  ]}
                  aria-hidden="true"
                >
                  {logo.svg && <Fragment set:html={logo.svg} />}
                  {logo.image && <Image src={logo.image} alt="" width={10} densities={[1, 2]} class="size-2.5" />}
                </span>
                <span>
                  {data.company} <span class="text-muted">· {data.contract}</span>
                </span>
              </p>
              <p class="max-w-prose text-muted">{data.summary}</p>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
