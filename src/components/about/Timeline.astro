---
/*
 * Parcours professionnel en frise chronologique : un point par poste, reliés par un filet fin.
 * Sur grand écran, un sticker au logo de l'entreprise se place à droite de chaque poste.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Tag from '../ui/Tag.astro';
import { fr } from '../../i18n/fr';

const experiences = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);

// Les stickers sont rangés dans src/assets/stickers/ et désignés par leur nom dans experiences.yaml.
const stickers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/stickers/*.{png,webp,svg}', {
  eager: true,
});
const stickerFor = (path?: string) => (path ? stickers[`/src/assets/${path}`]?.default : undefined);

// En attendant les vrais stickers : une forme et une inclinaison différentes pour chaque poste.
const placeholderShapes = [
  'size-32 rounded-full -rotate-6',
  'h-28 w-40 rounded-card rotate-3',
  'h-24 w-44 rounded-full -rotate-2',
];
---

<section aria-labelledby="parcours-titre" class="mx-auto w-full max-w-site px-gutter pt-section">
  <h2 id="parcours-titre" class="text-h2 font-medium">{fr.about.experience.title}</h2>

  <!-- Les colonnes sont partagées par toutes les lignes (subgrid) : la colonne des dates prend
       la largeur de la plus longue et commence au bord gauche, sous le titre. -->
  <ol class="mt-10 grid grid-cols-[1.5rem_1fr] gap-x-4 md:mt-14 md:grid-cols-[max-content_1.5rem_1fr] md:gap-x-8 lg:grid-cols-[max-content_1.5rem_1fr_auto]">
    {
      experiences.map(({ data }, index) => {
        const sticker = stickerFor(data.sticker);
        return (
          <li class="col-span-full grid grid-cols-subgrid">
            {/* Dates : à gauche sur desktop, au-dessus du poste sur mobile. */}
            <p class="col-start-2 text-small font-medium text-muted tabular-nums md:col-start-1 md:row-start-1 md:pt-1 md:text-right">
              {data.start} — {data.end ?? fr.about.experience.today}
            </p>

            {/* Point et filet de la frise. */}
            <div class="relative col-start-1 row-span-2 row-start-1 flex justify-center md:col-start-2">
              <span
                class:list={['relative z-1 mt-1.5 size-3 rounded-full', data.current ? 'bg-accent' : 'bg-neutral-300']}
              />
              {index < experiences.length - 1 && <span class="absolute top-6 bottom-0 w-px bg-line" />}
            </div>

            <div class="col-start-2 flex flex-col gap-2 pt-2 pb-12 md:col-start-3 md:row-start-1 md:pt-0 md:pb-16">
              <h3 class="flex flex-wrap items-center gap-x-3 gap-y-2 text-h3 font-medium">
                {data.role}
                {data.current && <Tag tone="accent">{fr.about.experience.current}</Tag>}
              </h3>
              <p class="text-body font-medium">
                {data.company} <span class="text-muted">· {data.contract}</span>
              </p>
              <p class="max-w-prose text-muted">{data.summary}</p>
            </div>

            {/* Sticker : desktop seulement, aligné en haut du poste et à droite. */}
            <div class="hidden justify-end lg:col-start-4 lg:row-start-1 lg:flex lg:pb-16" aria-hidden="true">
              {sticker ? (
                <Image src={sticker} alt="" width={176} class="h-auto w-44" />
              ) : (
                <div
                  class:list={[
                    'grid place-items-center bg-placeholder',
                    placeholderShapes[index % placeholderShapes.length],
                  ]}
                >
                  <span class="label-micro">{fr.about.experience.sticker(data.company)}</span>
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
