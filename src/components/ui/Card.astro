---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import Tag from './Tag.astro';
import { fr } from '../../i18n/fr';

interface Props {
  href: string;
  title: string;
  /** Petite ligne au-dessus du titre, par exemple le nom du projet. */
  eyebrow?: string;
  /** Pastille violette à côté de l'eyebrow, par exemple « En cours ». */
  badge?: string;
  tags?: string[];
  /** Visuel de la carte. Tant qu'il est absent, un emplacement neutre s'affiche. */
  image?: { src: ImageMetadata; alt: string };
  /** Le visuel est chargé tout de suite (cartes visibles dès l'arrivée sur la page). */
  eager?: boolean;
}

const { href, title, eyebrow, badge, tags = [], image, eager = false } = Astro.props;
const zoom = 'transition-transform duration-(--duration-slow) ease-out group-hover:scale-102';
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-card bg-surface transition-colors duration-(--duration-base) ease-out hover:bg-surface-hover"
>
  <div class="overflow-hidden">
    {
      image ? (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          class:list={['aspect-4/3 w-full object-cover', zoom]}
        />
      ) : (
        <Placeholder label="Visuel à venir" class:list={['rounded-none', zoom]} />
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6 lg:p-8">
    <div class="flex flex-col gap-1.5">
      {
        eyebrow && (
          <p class="flex items-center gap-2 text-small font-medium text-muted">
            {eyebrow}
            {/* Marge négative : la pastille ne doit pas rendre cette ligne plus haute que sur les autres cartes. */}
            {badge && (
              <span class="-my-1">
                <Tag tone="accent">{badge}</Tag>
              </span>
            )}
          </p>
        )
      }
      <h3 class="text-h3 font-medium">{title}</h3>
    </div>
    {
      tags.length > 0 && (
        <ul class="mt-auto flex flex-wrap gap-1.5" aria-label={fr.projects.roles}>
          {tags.map((tag) => (
            <li>
              <Tag on="surface">{tag}</Tag>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</a>
