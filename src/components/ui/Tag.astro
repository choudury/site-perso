---
interface Props {
  /** Fond sur lequel le tag est posé, pour rester visible. */
  on?: 'page' | 'surface';
  /** neutral : rôle, catégorie. accent : état à signaler discrètement (« En cours »). */
  tone?: 'neutral' | 'accent';
  /** md : rôles sur les cartes. lg : thèmes mis en avant (disponibilités). */
  size?: 'md' | 'lg';
}

const { on = 'page', tone = 'neutral', size = 'md' } = Astro.props;

const background =
  tone === 'accent' ? 'bg-accent-soft text-accent' : on === 'page' ? 'bg-surface text-muted' : 'bg-page text-muted';
---

<span
  class:list={[
    'inline-flex items-center rounded-control font-medium',
    size === 'lg' ? 'px-4 py-2 text-body' : 'px-2.5 py-1 text-small',
    background,
  ]}
>
  <slot />
</span>
