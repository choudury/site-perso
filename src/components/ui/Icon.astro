---
/*
 * Icône insérée dans la page au moment du build.
 * Par défaut, une icône d'interface Lucide, qui prend la couleur du texte qui l'entoure.
 * Avec le préfixe « emoji: », un emoji en couleurs (Fluent Emoji), identique sur tous les appareils.
 */
import { getIconData, iconToSVG } from '@iconify/utils';
import emoji from '@iconify-json/fluent-emoji-flat/icons.json';
import lucide from '@iconify-json/lucide/icons.json';

interface Props {
  name: string;
  class?: string;
  /** Texte lu par les lecteurs d'écran. Sans label, l'icône est décorative. */
  label?: string;
  [key: `data-${string}`]: string | undefined;
}

const { name, class: className, label, ...rest } = Astro.props;

const data = name.startsWith('emoji:') ? getIconData(emoji, name.slice(6)) : getIconData(lucide, name);
if (!data) throw new Error(`Icône introuvable : ${name}`);
const { body, attributes } = iconToSVG(data);
---

<svg
  viewBox={attributes.viewBox}
  class:list={['shrink-0', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={body}
  {...rest}
/>
