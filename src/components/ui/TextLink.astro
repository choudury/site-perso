---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  /** inline : lien dans un texte. arrow : lien d'action autonome, suivi d'une flèche. */
  variant?: 'inline' | 'arrow';
} & HTMLAttributes<'a'>;

const { variant = 'inline', class: className, ...rest } = Astro.props;

const variants = {
  inline:
    'text-accent underline decoration-accent/35 decoration-1 underline-offset-4 hover:decoration-accent',
  arrow: 'group inline-flex items-center gap-1.5 font-medium text-ink hover:text-accent',
};
---

<a
  class:list={[
    'transition-colors duration-(--duration-fast) ease-out',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
  {
    variant === 'arrow' && (
      <span
        aria-hidden="true"
        class="inline-block transition-transform duration-(--duration-fast) ease-out group-hover:translate-x-0.5"
      >
        →
      </span>
    )
  }
</a>
