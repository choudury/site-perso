---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'secondary';
  href?: string;
} & HTMLAttributes<'a'> & HTMLAttributes<'button'>;

const { variant = 'primary', href, class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-accent text-on-accent hover:bg-accent-strong',
  secondary: 'bg-surface text-ink hover:bg-surface-hover',
};

const classes = [
  'inline-flex h-11 items-center justify-center gap-2 rounded-control px-5',
  'text-body font-medium whitespace-nowrap',
  'transition-colors duration-(--duration-fast) ease-out',
  variants[variant],
  className,
];

const Tag = href ? 'a' : 'button';
---

<Tag href={href} type={href ? undefined : 'button'} class:list={classes} {...rest}>
  <slot />
</Tag>
