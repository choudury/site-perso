---
interface Props {
  /** Ce qui viendra à cet emplacement, lu par les lecteurs d'écran et affiché en petit. */
  label: string;
  /** Format de l'emplacement, par exemple « 4 / 3 » ou « 1 / 1 ». */
  ratio?: string;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { label, ratio = '4 / 3', class: className, ...rest } = Astro.props;
---

<div
  role="img"
  aria-label={`Emplacement : ${label}`}
  class:list={['flex items-center justify-center rounded-card bg-placeholder', className]}
  style={`aspect-ratio: ${ratio}`}
  {...rest}
>
  <span class="label-micro">{label}</span>
</div>
