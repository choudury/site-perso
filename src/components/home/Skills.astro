---
import { getCollection } from 'astro:content';
import ToolIcon from '../ui/ToolIcon.astro';
import { fr } from '../../i18n/fr';

const groups = (await getCollection('competences')).sort((a, b) => a.data.order - b.data.order);
---

<section aria-labelledby="competences-titre" class="mx-auto max-w-site px-gutter pt-section">
  <h2 id="competences-titre" class="text-h2 font-medium">{fr.skills.title}</h2>

  <ul class="mt-10 grid gap-4 md:mt-14 md:grid-cols-2 md:gap-6">
    {
      groups.map(({ data }) => (
        <li class="flex flex-col rounded-card bg-surface p-5 sm:p-8 lg:p-10">
          <h3 class="text-h3 font-medium">{data.title}</h3>
          <p class="mt-3 max-w-prose text-muted">{data.text}</p>
          <ul class="mt-8 -ml-1.5 grid grid-cols-4 gap-x-2 gap-y-6 sm:-ml-2 sm:flex sm:flex-wrap sm:gap-x-4" aria-label={fr.skills.tools}>
            {data.tools.map((tool) => (
              <ToolIcon {...tool} />
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
