---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import { fr } from '../../i18n/fr';

const projects = (await getCollection('projets')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projets" aria-labelledby="projets-titre" class="mx-auto max-w-site scroll-mt-8 px-gutter pt-section">
  <h2 id="projets-titre" class="text-h2 font-medium">{fr.projects.title}</h2>

  <ul class="mt-10 grid gap-4 md:mt-14 md:grid-cols-2 md:gap-6">
    {
      projects.map(({ id, data }) => (
        <li>
          <Card
            href={`/projets/${id}/`}
            eyebrow={data.name}
            badge={data.inProgress ? fr.projects.inProgress : undefined}
            title={data.cardTitle}
            tags={data.roles}
            image={data.cover && { src: data.cover, alt: data.coverAlt ?? '' }}
          />
        </li>
      ))
    }
  </ul>
</section>
