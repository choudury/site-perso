---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import { fr } from '../../i18n/fr';

const projects = (await getCollection('projets')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projets" aria-labelledby="projets-titre" class="mx-auto max-w-site scroll-mt-8 px-gutter pt-section">
  <!-- Titre lu par les lecteurs d'écran seulement : les cartes parlent d'elles-mêmes. -->
  <h2 id="projets-titre" class="sr-only">{fr.projects.title}</h2>

  <ul class="grid gap-10 md:grid-cols-2 md:gap-x-10 md:gap-y-14">
    {
      projects.map(({ id, data }) => (
        <li>
          <Card
            href={`/projets/${id}/`}
            eyebrow={data.name}
            badge={
              data.currentJob ? fr.projects.currentJob : data.inProgress ? fr.projects.inProgress : undefined
            }
            title={data.mission}
            tags={data.roles}
            image={data.cover && { src: data.cover, alt: data.coverAlt ?? '' }}
          />
        </li>
      ))
    }
  </ul>
</section>
