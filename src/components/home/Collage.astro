---
/*
 * Visuels personnels disposés en éventail : 5 sur desktop, 3 sur mobile.
 * Formats verticaux ou carrés uniquement (couverture, pochette). Les cartes se chevauchent
 * légèrement et pivotent depuis leur base, de 2 à 4° vers l'extérieur.
 */
import Placeholder from '../ui/Placeholder.astro';
import { fr } from '../../i18n/fr';

const labels = fr.presentation.collage;

type Fan = { r: number; y: number };
type Item = { label: string; ratio: string; desktop: Fan; mobile?: Fan; center?: boolean };

// r : rotation en degrés. y : décalage vers le bas, en % de la hauteur de la carte.
// Sans réglage mobile, le visuel n'apparaît que sur desktop.
const items: Item[] = [
  { label: labels.mountain, ratio: '3 / 4', desktop: { r: -4, y: 14 } },
  { label: labels.album, ratio: '1 / 1', desktop: { r: -2, y: 6 }, mobile: { r: -3, y: 8 } },
  {
    label: labels.toulouse,
    ratio: '3 / 4',
    desktop: { r: 0, y: 0 },
    mobile: { r: 0, y: 0 },
    center: true,
  },
  { label: labels.book, ratio: '2 / 3', desktop: { r: 2, y: 6 }, mobile: { r: 3, y: 8 } },
  { label: labels.poster, ratio: '2 / 3', desktop: { r: 4, y: 14 } },
];

const vars = (f: Fan, prefix: string) => `--${prefix}r: ${f.r}deg; --${prefix}y: ${f.y}%;`;

// Plus une carte est proche du centre, plus elle passe devant ses voisines.
const centerIndex = items.findIndex((item) => item.center);
const layer = (index: number) => `z-index: ${items.length - Math.abs(index - centerIndex)};`;
---

<div class="mx-auto flex max-w-fan items-center justify-center">
  {
    items.map((item, index) => (
      <div
        class:list={['fan-item', item.center && 'fan-center', !item.mobile && 'hidden md:block']}
        style={vars(item.desktop, 'd') + (item.mobile ? vars(item.mobile, 'm') : '') + layer(index)}
      >
        <Placeholder label={item.label} ratio={item.ratio} class="shadow-soft" />
      </div>
    ))
  }
</div>

<style>
  /* Mobile : 3 cartes. Chaque carte recouvre un peu sa voisine (marge négative). */
  .fan-item {
    position: relative;
    flex: none;
    width: 34%;
    margin-inline: -2.5%;
    transform-origin: 50% 100%;
    translate: 0 var(--my);
    rotate: var(--mr);
  }
  .fan-center {
    width: 38%;
  }

  /* Desktop : 5 cartes, la carte centrale légèrement plus grande et au premier plan. */
  @media (width >= 48rem) {
    .fan-item {
      width: 19%;
      margin-inline: -1.5%;
      translate: 0 var(--dy);
      rotate: var(--dr);
    }
    .fan-center {
      width: 22%;
    }
  }
</style>
