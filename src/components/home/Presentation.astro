---
import Button from '../ui/Button.astro';
import GalleryFrame from './GalleryFrame.astro';
import GalleryPicker from './GalleryPicker.astro';
import { fr } from '../../i18n/fr';
---

<!-- Desktop : emojis, titre, texte et bouton à gauche, photo à droite. Mobile : photo, puis le reste.
     Les emojis choisissent la photo affichée. -->
<section
  aria-labelledby="presentation-titre"
  class="mx-auto grid max-w-site gap-14 px-gutter pt-section lg:grid-cols-12 lg:items-center lg:gap-6"
  data-gallery
>
  <div class="flex flex-col gap-6 lg:col-span-5">
    <GalleryPicker />
    <h2 id="presentation-titre" class="pt-2 text-h2 font-medium">{fr.presentation.title}</h2>
    <div class="flex max-w-prose flex-col gap-4 text-lead font-light text-muted">
      {fr.presentation.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="pt-2">
      <Button href="/a-propos/" variant="secondary">
        {fr.presentation.cta}
        <span aria-hidden="true">→</span>
      </Button>
    </div>
  </div>

  <div class="order-first lg:order-none lg:col-span-6 lg:col-start-7">
    <GalleryFrame />
  </div>
</section>
