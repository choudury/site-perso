---
import LocalInfo from '../LocalInfo.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import { fr } from '../../i18n/fr';

// L'accroche est découpée en mots pour les faire apparaître un par un.
const strongWords = fr.hero.titleStrong.split(' ');
const lightWords = fr.hero.titleLight.split(' ');
// Le dernier fragment (« l’ ») reste collé au mot en violet.
const lastLight = lightWords.pop();
---

<section data-hero class="relative mx-auto max-w-site px-gutter pt-5 md:pt-8">
  <!-- Fond : quelques filets verticaux très clairs (desktop seulement), qui commencent sous le menu
       et s'effacent en haut et en bas. De temps en temps, un trait violet descend le long de l'un d'eux. -->
  <div class="hero-lines pointer-events-none absolute inset-x-0 top-24 -bottom-24 px-gutter max-md:hidden md:top-32" aria-hidden="true">
    <div class="grid h-full grid-cols-5">
      {
        [1, 2, 3, 4].map((line) => (
          <span class="relative border-r border-line" data-hero-line>
            <span class="hero-spark" style={`--line: ${line}`} />
          </span>
        ))
      }
    </div>
  </div>

  <SiteHeader />

  <!-- Halo de la couleur du fond autour du texte : les filets s'effacent derrière les lettres. -->
  <div class="hero-text relative flex flex-col gap-8 pt-section md:gap-10">
    <!-- Retrait de 0,05 em : la courbe du « C » laisse un blanc à gauche du glyphe. On le compense
         pour que le titre s'aligne à l'œil sur la photo et sur le drapeau. -->
    <h1 class="-ml-[0.05em] text-display">
      <span class="font-medium md:block">
        {
          strongWords.map((word) => (
            <>
              <span class="word-mask">
                <span class="word" data-word>
                  {word}
                </span>
              </span>{' '}
            </>
          ))
        }
      </span>
      <span class="font-light">
        {
          lightWords.map((word) => (
            <>
              <span class="word-mask">
                <span class="word" data-word>
                  {word}
                </span>
              </span>{' '}
            </>
          ))
        }
        <span class="word-mask">
          <span class="word" data-word>
            {lastLight}<span class="text-accent" data-hero-accent>{fr.hero.titleAccent}</span>{
              fr.hero.titleEnd
            }
          </span>
        </span>
      </span>
    </h1>
    <!-- Décalé de 2 px : le drapeau, à bord droit, s'aligne sur la barre du « D » de la ligne au-dessus. -->
    <div class="pl-0.5" data-hero-time>
      <LocalInfo />
    </div>
  </div>
</section>

<style>
  /* Chaque mot glisse depuis le bas à l'intérieur d'un cache. Le cache déborde un peu
     en haut et en bas pour ne couper ni les accents ni les jambages (g, p, q).
     Il ne coupe que pendant l'animation d'entrée (data-intro), pour laisser ensuite le halo déborder. */
  .word-mask {
    display: inline-block;
    vertical-align: top;
    padding-block: 0.1em 0.16em;
    margin-block: -0.1em -0.16em;
  }
  .word {
    display: inline-block;
  }
  [data-intro] .word-mask {
    overflow: hidden;
  }

  .hero-text {
    text-shadow:
      0 0 0.15em var(--color-page),
      0 0 0.3em var(--color-page),
      0 0 0.5em var(--color-page),
      0 0 0.8em var(--color-page);
  }

  /* Les filets s'effacent vers le haut et vers le bas de la zone. */
  .hero-lines {
    mask-image: linear-gradient(to bottom, transparent, black 25%, black 60%, transparent);
  }
  /* Trait violet qui parcourt un filet de haut en bas, puis attend avant de repartir.
     Chaque filet a son décalage : les traits ne partent jamais ensemble. */
  .hero-spark {
    position: absolute;
    top: 0;
    right: -1px;
    width: 1px;
    height: 8rem;
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
    opacity: 0;
    animation: hero-spark 10s var(--ease-in-out) infinite;
    animation-delay: calc(var(--line) * 2.5s - 1s);
  }
  @keyframes hero-spark {
    0% {
      translate: 0 -8rem;
      opacity: 0;
    }
    8%,
    38% {
      opacity: 0.6;
    }
    45%,
    100% {
      translate: 0 var(--lines-h, 40rem);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-spark {
      display: none;
    }
  }

  /* Tant que l'animation n'est pas prête, le hero reste masqué pour éviter un flash.
     Sécurités : rien n'est masqué sans JavaScript, ni quand le visiteur demande
     moins d’animations, ni au-delà de 4 s si le script tarde (classe js-failsafe). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.js-failsafe)) [data-hero] {
      visibility: hidden;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { preloadDone } from '../../lib/preload';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const root = document.documentElement;

  // Hauteur des filets, pour que le trait violet les parcoure jusqu'en bas.
  const lines = hero?.querySelector<HTMLElement>('.hero-lines');
  if (lines) {
    new ResizeObserver(() => lines.style.setProperty('--lines-h', `${lines.offsetHeight}px`)).observe(lines);
  }

  // Si la sécurité s'est déjà déclenchée, le hero est affiché : on ne le rejoue pas.
  if (hero && !root.classList.contains('js-failsafe')) {
    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const header = hero.querySelectorAll('header > a, header nav li, header > button');
      const status = hero.querySelector('header [data-status]');
      const words = hero.querySelectorAll('[data-word]');
      const accent = hero.querySelector('[data-hero-accent]');
      const time = hero.querySelector('[data-hero-time]');
      const ink = getComputedStyle(hero).color;
      const heroLines = hero.querySelectorAll('[data-hero-line]');

      // La séquence attend la fin de l'écran de chargement pour démarrer.
      const tl = gsap.timeline({
        paused: true,
        defaults: { ease: 'expo.out' },
        onComplete: () => hero.removeAttribute('data-intro'),
      });
      hero.setAttribute('data-intro', '');

      // 0. Les filets du fond se tracent de haut en bas.
      tl.from(heroLines, { scaleY: 0, transformOrigin: 'top', duration: 1.8, stagger: 0.12, ease: 'expo.inOut' }, 0);

      // 1. L'en-tête descend légèrement en fondu.
      tl.from(header, { y: -10, autoAlpha: 0, duration: 0.9, stagger: 0.06 }, 0);

      // 2. Les mots montent un par un depuis leur cache.
      tl.from(words, { yPercent: 115, duration: 1.1, stagger: 0.075 }, 0.15);

      // 3. « acquisition » arrive en noir puis prend sa couleur violette.
      tl.from(accent, { color: ink, duration: 0.9, ease: 'power2.inOut' }, '-=0.55');

      // 4. Le voyant de statut et l'heure locale ferment la séquence.
      if (status) tl.from(status, { scale: 0, duration: 0.7, ease: 'back.out(2.2)' }, '<');
      tl.from(time, { y: 8, autoAlpha: 0, duration: 0.9 }, '<0.1');

      // Les états de départ sont posés : le hero peut devenir visible.
      gsap.set(hero, { visibility: 'visible' });
      preloadDone.then(() => tl.play());
    });
  }
</script>
