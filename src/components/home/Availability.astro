---
/*
 * Disponibilités, entre « Ma boîte à outils » et le bloc contact : sans boîte ni fond, pour faire
 * respirer la page entre les cartes d'outils et la grande carte contact.
 * Le badge foncé « Disponible » sert de titre ; dessous, une phrase en gris et les sujets de
 * prédilection en badges. À droite, une vidéo courte ou un GIF.
 * Les textes sont dans fr.availability.
 */
import Placeholder from '../ui/Placeholder.astro';
import Tag from '../ui/Tag.astro';
import { fr } from '../../i18n/fr';

const t = fr.availability;

// Le visuel est à déposer dans src/assets/disponible/ (un seul fichier : .mp4, .webm, .gif ou image).
// Vidéo : lue en boucle, sans le son. Sans fichier, un emplacement neutre s'affiche.
const files = import.meta.glob<string>('/src/assets/disponible/*.{mp4,webm,gif,jpg,jpeg,png,webp}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const [mediaPath] = Object.keys(files).sort();
const mediaUrl = mediaPath ? files[mediaPath] : undefined;
const isVideo = /\.(mp4|webm)$/.test(mediaPath ?? '');
const RATIO = '4 / 5';
---

<section aria-labelledby="disponibilites-titre" class="mx-auto w-full max-w-site px-gutter pt-section">
  <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-6">
    <div class="flex flex-col items-start gap-8 lg:col-span-7">
      <!-- Mobile : badge et phrase un cran plus grands, pour occuper la largeur de l'écran. -->
      <h2 id="disponibilites-titre" class="availability-badge text-h3 lg:text-lead">
        <span class="availability-dot" aria-hidden="true"></span>
        {t.status}
      </h2>
      <!-- En deux tons, comme les titres du site : l'essentiel en noir, la précision en gris.
           Les deux parties s'enchaînent sur les mêmes lignes, équilibrées entre elles. -->
      <p class="text-h1 text-balance lg:text-h2">
        <span class="font-medium">{t.textStrong}</span>{' '}
        <span class="font-light text-muted">{t.textLight}</span>
      </p>
      <div class="flex flex-col gap-4">
        <p class="text-small font-medium text-muted">{t.themesLabel}</p>
        <ul class="flex flex-wrap gap-2">
          {
            t.themes.map((theme) => (
              <li>
                <Tag size="lg">{theme}</Tag>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="overflow-hidden rounded-card lg:col-span-5 lg:col-start-8" style={`aspect-ratio: ${RATIO}`}>
      {
        mediaUrl && isVideo ? (
          <video
            src={mediaUrl}
            class="size-full object-cover"
            autoplay
            muted
            loop
            playsinline
            aria-hidden="true"
            data-availability-video
          />
        ) : mediaUrl ? (
          <img src={mediaUrl} alt="" class="size-full object-cover" loading="lazy" />
        ) : (
          <Placeholder label={t.mediaLabel} ratio={RATIO} class="size-full rounded-none" />
        )
      }
    </div>
  </div>
</section>

<style>
  /* Badge foncé « Disponible », qui sert de titre : plus grand que le texte courant mais en graisse
     normale, avec de l'air autour du mot. Marges et voyant en em pour suivre la taille du texte.
     Le halo du voyant s'élargit en boucle. */
  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.9em 0.38em 0.7em;
    border-radius: var(--radius-full);
    background: var(--color-ink);
    color: var(--color-on-night);
  }
  .availability-dot {
    position: relative;
    width: 0.4em;
    height: 0.4em;
    border-radius: var(--radius-full);
    background: var(--color-online-bright);
  }
  .availability-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: availability-pulse 2s var(--ease-out) infinite;
  }
  @keyframes availability-pulse {
    from {
      scale: 1;
      opacity: 0.6;
    }
    to {
      scale: 2.4;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .availability-dot::after {
      display: none;
    }
  }
</style>

<script>
  // Moins d'animations demandé : la vidéo reste sur sa première image.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-availability-video]').forEach((video) => {
      video.removeAttribute('autoplay');
      video.pause();
    });
  }
</script>
