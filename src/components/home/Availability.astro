---
/*
 * Disponibilités, entre « Ma boîte à outils » et le bloc contact : sans boîte ni fond, pour faire
 * respirer la page entre les cartes d'outils et la grande carte contact.
 * Trois mises en page à comparer (page interne /design-system/disponibilites/) :
 *   - editorial : titre en grand à gauche, sujets de prédilection en badges à droite ;
 *   - photo : texte et badges à gauche, photo à droite ;
 *   - liste : les sujets écrits en toutes lettres, comme une phrase.
 * Les textes sont dans fr.availability.
 */
import Placeholder from '../ui/Placeholder.astro';
import Tag from '../ui/Tag.astro';
import { fr } from '../../i18n/fr';

interface Props {
  variant?: 'editorial' | 'photo' | 'liste';
}

const { variant = 'editorial' } = Astro.props;
const t = fr.availability;
const id = `disponibilites-titre-${variant}`;
---

<section aria-labelledby={id} class="mx-auto w-full max-w-site px-gutter pt-section">
  {
    variant === 'editorial' && (
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-6">
        <div class="flex flex-col items-start gap-8 lg:col-span-7">
          <p class="availability-badge">
            <span class="availability-dot" aria-hidden="true" />
            {t.status}
          </p>
          <h2 id={id} class="text-h1 text-balance">
            <span class="block font-medium">{t.titleStrong}</span>
            <span class="block font-light text-muted">{t.titleLight}</span>
          </h2>
        </div>
        <div class="flex flex-col gap-4 lg:col-span-4 lg:col-start-9">
          <p class="text-small font-medium text-muted">{t.themesLabel}</p>
          <ul class="flex flex-wrap gap-2">
            {t.themes.map((theme) => (
              <li>
                <Tag>{theme}</Tag>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  {
    variant === 'photo' && (
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-6">
        <div class="flex flex-col items-start gap-8 lg:col-span-6">
          <p class="availability-badge">
            <span class="availability-dot" aria-hidden="true" />
            {t.status}
          </p>
          <h2 id={id} class="text-h2 text-balance">
            <span class="block font-medium">{t.titleStrong}</span>
            <span class="block font-light text-muted">{t.titleLight}</span>
          </h2>
          <div class="flex flex-col gap-4">
            <p class="text-small font-medium text-muted">{t.themesLabel}</p>
            <ul class="flex flex-wrap gap-2">
              {t.themes.map((theme) => (
                <li>
                  <Tag size="lg">{theme}</Tag>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <Placeholder label={t.photoLabel} ratio="4 / 5" />
        </div>
      </div>
    )
  }

  {
    variant === 'liste' && (
      <div class="flex flex-col items-start gap-8">
        <p class="availability-badge">
          <span class="availability-dot" aria-hidden="true" />
          {t.status}
        </p>
        <h2 id={id} class="text-h2 text-balance">
          <span class="block font-medium">{t.titleStrong}</span>
          <span class="block font-light text-muted">{t.titleLight}</span>
        </h2>
        <div class="flex flex-col gap-3">
          <p class="text-small font-medium text-muted">{t.themesLabel}</p>
          {/* Les sujets en toutes lettres, séparés par des points médians. */}
          <ul class="flex flex-wrap gap-x-3 gap-y-1 text-h3 font-light">
            {t.themes.map((theme, index) => (
              <li class="flex gap-3">
                {theme}
                {index < t.themes.length - 1 && (
                  <span class="text-placeholder" aria-hidden="true">
                    ·
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
</section>

<style>
  /* Badge foncé « Disponible », avec un voyant vert vif dont le halo s'élargit en boucle. */
  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.875rem 0.375rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-ink);
    color: var(--color-on-night);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    font-weight: 500;
  }
  .availability-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-online-bright);
  }
  .availability-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: availability-pulse 2s var(--ease-out) infinite;
  }
  @keyframes availability-pulse {
    from {
      scale: 1;
      opacity: 0.6;
    }
    to {
      scale: 3;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .availability-dot::after {
      display: none;
    }
  }
</style>
