---
/*
 * Disponibilités, juste sous les projets : un voyant vert qui pulse, le temps libre pour
 * un nouveau projet, les thèmes privilégiés et un lien vers le bloc contact.
 * Les textes sont dans fr.availability.
 */
import Tag from '../ui/Tag.astro';
import { fr } from '../../i18n/fr';
---

<section aria-labelledby="disponibilites-titre" class="mx-auto w-full max-w-site px-gutter pt-16 md:pt-24">
  <div class="flex flex-col gap-6">
    <p class="flex items-center gap-3 text-body font-medium">
      <span class="availability-dot relative size-2.5 rounded-full bg-online" aria-hidden="true"></span>
      {fr.availability.status}
    </p>
    <h2 id="disponibilites-titre" class="text-h3">
      <span class="block font-medium text-balance">{fr.availability.titleStrong}</span>
      <span class="block font-light text-muted">{fr.availability.titleLight}</span>
    </h2>
    <ul class="flex flex-wrap gap-2">
      {
        fr.availability.themes.map((theme) => (
          <li>
            <Tag size="lg">{theme}</Tag>
          </li>
        ))
      }
    </ul>
    <a
      href="#contact"
      class="group inline-flex items-center gap-2 self-start text-body font-medium text-muted transition-colors duration-(--duration-fast) ease-out hover:text-accent"
    >
      {fr.availability.contact}
      <span
        aria-hidden="true"
        class="transition-transform duration-(--duration-fast) ease-out group-hover:translate-x-1">→</span
      >
    </a>
  </div>
</section>

<style>
  /* Halo qui s'élargit et s'efface autour du point, en boucle. */
  .availability-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: availability-pulse 2s var(--ease-out) infinite;
  }
  @keyframes availability-pulse {
    from {
      scale: 1;
      opacity: 0.6;
    }
    to {
      scale: 3;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .availability-dot::after {
      display: none;
    }
  }
</style>
