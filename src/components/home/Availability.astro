---
/*
 * Disponibilités, juste sous les projets : le temps libre pour un nouveau projet
 * et les thèmes privilégiés. Les textes sont dans fr.availability.
 */
import Tag from '../ui/Tag.astro';
import { fr } from '../../i18n/fr';
---

<section aria-labelledby="disponibilites-titre" class="mx-auto w-full max-w-site px-gutter pt-16 md:pt-24">
  <div class="flex flex-col gap-6">
    <p class="text-small font-medium text-muted">{fr.availability.label}</p>
    <h2 id="disponibilites-titre" class="text-h3 text-balance">
      <span class="block font-medium">{fr.availability.titleStrong}</span>
      <span class="block font-light text-muted">{fr.availability.titleLight}</span>
    </h2>
    <ul class="flex flex-wrap gap-2">
      {
        fr.availability.themes.map((theme) => (
          <li>
            <Tag>{theme}</Tag>
          </li>
        ))
      }
    </ul>
  </div>
</section>
