---
import France from '../../assets/drapeaux/france.svg';
import Logo from '../../assets/logo.svg';
import LocalInfo from '../LocalInfo.astro';
import { site } from '../../config/site';
import { fr } from '../../i18n/fr';

const socials = [
  { label: fr.footer.linkedin, href: site.socials.linkedin },
  { label: fr.footer.instagram, href: site.socials.instagram },
];

const linkClass =
  'text-small font-medium text-ink transition-colors duration-(--duration-fast) ease-out hover:text-accent';
---

<!-- Sous le bloc contact (qui est au premier plan) : en bas de page, le pied de page sort de dessous
     le bloc et descend jusqu'à sa place. -->
<footer aria-label={fr.footer.label} class="relative mx-auto w-full max-w-site px-gutter pb-gutter">
  <div class="flex flex-col gap-16 rounded-card bg-surface p-6 sm:p-8 md:gap-20 lg:p-10" data-footer-card>
    <div class="flex items-center justify-between gap-6">
      <a href="/" aria-label={`${site.name}, ${fr.nav.home}`} class="rounded-control">
        <Logo class="size-8 text-ink" aria-hidden="true" />
      </a>
      <ul class="flex items-center gap-6" aria-label={fr.footer.links}>
        {
          socials.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                {link.label}
                <span class="sr-only">{fr.footer.newTab}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <LocalInfo />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <p class="flex items-center gap-2 text-small text-muted">
          <France class="h-3 w-auto rounded-flag" aria-hidden="true" />
          {fr.footer.madeIn}
        </p>
        <p class="text-small text-muted">© {new Date().getFullYear()} {site.name}</p>
        <a href="/mentions-legales/" class={linkClass}>{fr.footer.legal}</a>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    const card = document.querySelector<HTMLElement>('[data-footer-card]');
    const contact = document.querySelector<HTMLElement>('[data-contact-card]');
    if (!card) return;

    // Pages sans bloc contact : le pied de page glisse simplement depuis le bas de l'écran.
    if (!contact) {
      gsap.from(card, {
        y: 120,
        duration: 1.1,
        ease: 'expo.out',
        scrollTrigger: { trigger: 'footer', start: 'top bottom' },
      });
      return;
    }

    // Départ : le bas du pied de page est calé sur le bas du bloc contact, donc caché derrière lui.
    // Il descend à sa place au fil des derniers pixels de défilement.
    const hiddenOffset = () =>
      -(card.getBoundingClientRect().bottom - (gsap.getProperty(card, 'y') as number) -
        contact.getBoundingClientRect().bottom);
    gsap.fromTo(
      card,
      { y: hiddenOffset },
      {
        y: 0,
        ease: 'none',
        immediateRender: false,
        scrollTrigger: {
          trigger: 'footer',
          start: 'top bottom',
          end: 'bottom bottom',
          scrub: 0.6,
          invalidateOnRefresh: true,
        },
      },
    );
  });
</script>
