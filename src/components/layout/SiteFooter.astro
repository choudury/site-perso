---
import France from '../../assets/drapeaux/france.svg';
import Logo from '../../assets/logo.svg';
import LocalInfo from '../LocalInfo.astro';
import { site } from '../../config/site';
import { fr } from '../../i18n/fr';

const socials = [
  { label: fr.footer.linkedin, href: site.socials.linkedin },
  { label: fr.footer.instagram, href: site.socials.instagram },
];

const linkClass =
  'text-small font-medium text-ink transition-colors duration-(--duration-fast) ease-out hover:text-accent';
---

<!-- Au premier plan : le bloc contact remonte de dessous le pied de page. -->
<footer aria-label={fr.footer.label} class="relative z-10 mx-auto w-full max-w-site px-gutter pb-gutter">
  <div class="flex flex-col gap-16 rounded-card bg-surface p-6 sm:p-8 md:gap-20 lg:p-10" data-footer-card>
    <div class="flex items-center justify-between gap-6">
      <a href="/" aria-label={`${site.name}, ${fr.nav.home}`} class="rounded-control">
        <Logo class="size-8 text-ink" aria-hidden="true" />
      </a>
      <ul class="flex items-center gap-6" aria-label={fr.footer.links}>
        {
          socials.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                {link.label}
                <span class="sr-only">{fr.footer.newTab}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <LocalInfo />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <p class="flex items-center gap-2 text-small text-muted">
          <France class="h-3 w-auto rounded-flag" aria-hidden="true" />
          {fr.footer.madeIn}
        </p>
        <p class="text-small text-muted">© {new Date().getFullYear()} {site.name}</p>
        <a href="/mentions-legales/" class={linkClass}>{fr.footer.legal}</a>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // À l'arrivée en bas de page, le pied de page glisse depuis le bas de l'écran.
  // Il reste opaque pendant le mouvement pour couvrir le bloc contact qui passe dessous.
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap.from('[data-footer-card]', {
      y: 120,
      duration: 1.1,
      ease: 'expo.out',
      scrollTrigger: { trigger: 'footer', start: 'top bottom' },
    });
  });
</script>
