---
/*
 * Appel à écrire, en bloc gris foncé pour marquer la fin de page.
 * Carte cliquable (ContactCard) avec la photo, l'adresse mail et une flèche. Réutilisé sur l'accueil et la page À propos.
 * Il passe au premier plan : le pied de page sort de dessous en bas de page (voir SiteFooter).
 */
import ContactCard from './ContactCard.astro';
import { fr } from '../i18n/fr';
---

<section aria-labelledby="contact-titre" class="relative z-10 mx-auto w-full max-w-site scroll-mt-8 px-gutter pt-section pb-6 md:pb-10" id="contact" data-contact>
  <div class="flex flex-col gap-10 rounded-card bg-night p-5 text-on-night sm:p-10 md:gap-14 lg:p-16" data-contact-card>
    <div class="flex flex-col gap-6">
      <h2 id="contact-titre" class="text-h1">
        <span class="block font-medium">{fr.contact.titleStrong}</span>
        <span class="block font-light text-night-muted">{fr.contact.titleLight}</span>
      </h2>
      <p class="max-w-prose text-lead font-light text-night-muted">{fr.contact.text}</p>
    </div>

    <ContactCard />
  </div>
</section>

