---
import { Image } from 'astro:assets';
import photo from '../assets/profil-dorian.png';
import { fr } from '../i18n/fr';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['relative shrink-0', className]}>
  <div class="size-full overflow-hidden rounded-control bg-placeholder">
    <!-- Recadrage sur le visage : la photo d'origine est cadrée large. -->
    <Image
      src={photo}
      alt={fr.hero.photoAlt}
      widths={[64, 128, 192]}
      sizes="56px"
      loading="eager"
      class="size-full object-cover"
      style="transform: translate(-25%, 30%) scale(1.6)"
    />
  </div>

  <!-- Voyant de statut : vert entre 8 h et 19 h (heure de Toulouse), lune sinon. -->
  <span
    data-status="unknown"
    role="img"
    class="status absolute -right-1 -bottom-1 grid size-5 place-items-center rounded-full bg-page"
  >
    <span class="status-dot size-2.5 rounded-full bg-online"></span>
    <svg
      class="status-moon size-3 text-muted"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"></path>
    </svg>
  </span>
</div>

<style>
  .status[data-status='unknown'] {
    visibility: hidden;
  }
  .status:not([data-status='online']) .status-dot,
  .status:not([data-status='offline']) .status-moon {
    display: none;
  }
</style>

<script>
  import '../lib/live-clock';
</script>
