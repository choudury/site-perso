---
import '@fontsource-variable/geist';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = '', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Signale que JavaScript est actif (les animations peuvent masquer leurs éléments de départ),
         avec une sécurité qui réaffiche tout si les scripts n'ont pas pris la main en 2,5 s. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(() => document.documentElement.classList.add('js-failsafe'), 2500);
    </script>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <slot />
  </body>
</html>
