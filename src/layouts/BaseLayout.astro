---
import '@fontsource-variable/geist';
import '../styles/global.css';
import Preloader from '../components/Preloader.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = '', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Favicon : le SVG passe en clair quand le navigateur est en thème sombre ; le .ico sert aux anciens navigateurs. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Signale que JavaScript est actif (les animations peuvent masquer leurs éléments de départ).
         L'écran de chargement est sauté s'il a déjà été vu pendant la visite ou si le visiteur demande
         moins d'animations. Sécurité : tout s'affiche si les scripts n'ont pas pris la main en 4 s. -->
    <script is:inline>
      {
        const root = document.documentElement;
        root.classList.add('js');
        let seen = false;
        try {
          seen = sessionStorage.getItem('preload-vu') === '1';
        } catch {}
        if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('no-preload');
        setTimeout(() => root.classList.add('js-failsafe'), 4000);
      }
    </script>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <!-- Le pied de page reste en bas de l'écran même sur une page courte. -->
  <body class="flex min-h-svh flex-col">
    <Preloader />
    <slot />
  </body>
</html>
